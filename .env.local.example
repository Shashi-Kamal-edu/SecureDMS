ENVIRONMENT=development
DATABASE_URL=sqlite:///./secure_dms.db

SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_DEV_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=http://127.0.0.1:7545
BLOCKCHAIN_PRIVATE_KEY=
CONTRACT_ADDRESS=

STORAGE_DIRECTORY=storage/documents
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,docx
ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,application/vnd.openxmlformats-officedocument.wordprocessingml.document

CORS_ORIGINS=http://localhost:5173
TESTING=false
